# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Comma-separated for multiple frontends, e.g. the admin portal on a
# separate domain: CORS_ORIGIN=https://pesamind.vercel.app,https://admin.pesamind.co.tz

# --- Database ---
DATABASE_URL="postgresql://pesamind:pesamind@localhost:5432/pesamind?schema=public"

# --- Auth ---
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Security / lockouts ---
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MAX_KYC_ATTEMPTS=5

# --- Encryption (required for NIDA/KYC profile sync) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Admin Portal sessions (deliberately shorter than customer sessions) ---
ADMIN_JWT_ACCESS_EXPIRES_IN=15m
ADMIN_SESSION_HOURS=8

# --- Biometric login (WebAuthn) ---
# RP_ID must be the exact hostname the frontend is served from (no scheme,
# no port) — e.g. pesamind.vercel.app. Defaults to "localhost" for local dev.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=PesaMind

# --- Push notifications (Web Push / VAPID) ---
# Generate once and keep stable across deploys — rotating these invalidates
# every customer's existing push subscription. Not third-party secrets;
# self-issued keys that identify this server to push relays (Apple/Google/
# Mozilla). See docs/PUSH_NOTIFICATIONS.md for how these were generated.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@pesamind.co.tz

# --- Provider mode: "mock" until each partnership/integration is live ---
KYC_PROVIDER=mock          # mock | nida
PAYMENTS_RAIL_PROVIDER=mock # mock | tips
CARD_FUNDING_PROVIDER=mock  # mock | visa
CARD_ISSUING_PROVIDER=mock  # mock | bpc_smartvista_sim | bpc_smartvista | <processor>
EMAIL_PROVIDER=mock         # mock | resend
SMS_PROVIDER=mock           # mock | africastalking
CBS_PROVIDER=mock           # mock | partner_bank
TIPS_RAIL_PROVIDER=mock     # mock | bot_tips

# --- Email (only used when EMAIL_PROVIDER=resend) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=PesaMind <onboarding@resend.dev>

# --- SMS (only used when SMS_PROVIDER=africastalking) ---
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=
MAX_PHONE_OTP_ATTEMPTS=5

# --- Real provider credentials (unused while providers are "mock") ---
NIDA_API_BASE_URL=
NIDA_CLIENT_ID=
NIDA_CLIENT_SECRET=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=PesaMind

TIPS_API_BASE_URL=
TIPS_PARTICIPANT_CODE=
TIPS_API_KEY=

VISA_API_BASE_URL=
VISA_CERT_PATH=
VISA_KEY_PATH=
ACQUIRER_MERCHANT_ID=

CARD_PROCESSOR_API_BASE_URL=
CARD_PROCESSOR_API_KEY=
CARD_PROCESSOR_PROGRAM_ID=

KYC_AMOUNT_THRESHOLD_TZS=50000

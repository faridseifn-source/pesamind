generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  FAILED
}

enum WalletType {
  PERSONAL
  SHARED
}

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  language     String   @default("en")
  avatarUrl    String?
  kycStatus    KycStatus @default(NONE)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? // login blocked until this time once attempts exceed the threshold

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  walletMemberships WalletMember[]
  categories        Category[]
  budgets           Budget[]
  card              Card?
  notifications     Notification[]
  kycVerification   KycVerification?
  refreshTokens     RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Wallet {
  id        String     @id @default(cuid())
  type      WalletType
  name      String?
  createdAt DateTime   @default(now())

  members      WalletMember[]
  transactions Transaction[]
}

model WalletMember {
  id       String @id @default(cuid())
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  walletId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  role     String @default("member") // owner | member

  @@unique([walletId, userId])
}

// Global default categories have userId = null; user-created ones are scoped to a user.
model Category {
  id     String  @id @default(cuid())
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?
  name   String
  color  String

  subcategories Subcategory[]
  budgets       Budget[]
  transactions  Transaction[]

  @@unique([userId, name])
}

model Subcategory {
  id         String   @id @default(cuid())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  name       String

  transactions Transaction[]

  @@unique([categoryId, name])
}

model Budget {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  limit      Decimal  @db.Decimal(14, 2)
  period     String   @default("monthly")

  @@unique([userId, categoryId, period])
}

model Transaction {
  id             String       @id @default(cuid())
  wallet         Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  walletId       String
  category       Category     @relation(fields: [categoryId], references: [id])
  categoryId     String
  subcategory    Subcategory? @relation(fields: [subcategoryId], references: [id])
  subcategoryId  String?
  amount         Decimal      @db.Decimal(14, 2) // negative = expense, positive = income
  merchant       String
  note           String?
  photoUrl       String?
  date           DateTime
  loggedByUserId String
  loggedByName   String
  source         String       @default("manual") // manual | scan | voice | import | lipa | gepg | luku
  createdAt      DateTime     @default(now())

  @@index([walletId, date])
}

model Card {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String   @unique
  processorRef String?  // opaque id from the card-issuing processor, once real
  last4        String
  holderName   String
  expiry       String
  frozen       Boolean  @default(false)
  dailyLimit   Decimal  @db.Decimal(14, 2) @default(500000)
  controls     Json     @default("{\"online\":true,\"contactless\":true,\"atm\":true}")
  balance      Decimal  @db.Decimal(14, 2) @default(0) // authoritative only while provider = mock

  activity CardActivity[]
}

model CardActivity {
  id     String   @id @default(cuid())
  card   Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId String
  type   String   // topup | oct | receive | transfer_out | bank_transfer | lipa | gepg | luku
  amount Decimal  @db.Decimal(14, 2)
  label  String
  sub    String?
  date   DateTime @default(now())

  @@index([cardId, date])
}

model KycVerification {
  id             String    @id @default(cuid())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String    @unique
  nidaNumberHash String    // never store the raw NIDA number
  sessionRef     String?   // opaque ref from the KYC provider for the in-flight attempt
  status         KycStatus @default(PENDING)
  method         String?   // otp | kbv
  attempts       Int       @default(0)
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Notification {
  id      String   @id @default(cuid())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  type    String
  title   String
  message String
  read    Boolean  @default(false)
  date    DateTime @default(now())

  @@index([userId, date])
}

// Deliberately not a foreign-key relation to User: an audit trail should
// survive independently of the account record it describes.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // e.g. "auth.login.success", "card.topup.gateway", "kyc.otp.verified"
  amount    Decimal? @db.Decimal(14, 2)
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// Ensures a client retry of a money-movement request (double-tap, flaky
// network, etc.) can't be processed twice — the caller sends an
// Idempotency-Key header; a repeated key with the same user returns the
// original stored response instead of re-running the operation.
model IdempotencyKey {
  id           String   @id @default(cuid())
  userId       String
  key          String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())

  @@unique([userId, key])
}
